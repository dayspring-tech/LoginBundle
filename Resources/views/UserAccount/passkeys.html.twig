{% extends "base.html.twig" %}

{% block title %}Passkeys{% endblock %}

{% block content %}
    <div class="row padding-bottom">
        <div class="col-md-4 col-md-offset-4">
            <div class="messages">
                {% include "sessionFlash.html.twig" %}
            </div>

            <h1>Passkeys</h1>
            <p>Passkeys are a secure way to authenticate without the need for a password. They are stored on your device and can be used to authenticate you without the need for a password.</p>

            <button class="btn btn-primary" id="btnRegBegin">Register new Passkey</button>

            <ul>
                {% for passkey in user.userWebauthns %}
                    {% if passkey.isActive %}
                    <li>Created {{ passkey.createdAt|date('m/d/Y') }}, Last Used {{ passkey.lastUsedAt ? passkey.lastUsedAt|date('m/d/Y') : 'never used' }} <a href="{{ path('account_passkeys_disable', {'id': passkey.id}) }}" class="btn btn-danger btn-xs">Disable</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}

{% block page_javascripts %}
    <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.es5.umd.min.js"></script>
    <script>
        const { browserSupportsWebAuthn, startRegistration } = SimpleWebAuthnBrowser;

        function displayAlert(message, type = 'danger') {
            $('#messages').prepend(`<div class="alert alert-${type}">${message}</div>`);
        }

        // Hide the Begin button if the browser is incapable of using WebAuthn
        if (!browserSupportsWebAuthn()) {
            displayAlert('<div class="alert alert-danger">Sorry, this browser does not support Passkeys</div>');
            document.querySelector('#btnRegBegin').style.display = 'none';
        } else {
            /**
             * Registration
             */
            document.querySelector('#btnRegBegin').addEventListener('click', async () => {
                const resp = await fetch('{{ path('passkeys_registration_options') }}');

                let attResp;
                try {
                    const opts = await resp.json();
                    attResp = await startRegistration(opts);
                } catch (error) {
                    if (error.name === 'InvalidStateError') {
                        displayAlert('Error: Authenticator was probably already registered by user');
                    } else {
                        displayAlert(error);
                    }

                    throw error;
                }

                const verificationResp = await fetch('{{ path('passkeys_registration_verify') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(attResp),
                });

                const verificationJSON = await verificationResp.json();

                if (verificationJSON && verificationJSON.verified) {
                    // refresh the page to show the new key
                    window.location.href = window.location.href;
                } else {
                    displayAlert('Oh no, something went wrong! Response: ' + JSON.stringify(verificationJSON));
                }
            });
        }
    </script>
{% endblock %}


