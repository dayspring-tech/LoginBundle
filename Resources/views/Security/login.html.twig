{% extends "base.html.twig" %}

{% block title %}Login{% endblock %}

{% block content %}
    <div class="row padding-bottom" id="login-form">
        <div class="col-md-4 col-md-offset-4">
            {% include "sessionFlash.html.twig" %}

            <h1>Log In</h1>

            <form action="{{ path('_login_check') }}" method="post" id="loginForm">
                {% if error %}
                    <div class="alert alert-danger">
                        {{ error.message|trans({}, 'messages')|raw }}
                    </div>
                {% endif %}

                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" class="form-control" id="username" name="_username"
                           value="{{ last_username }}" placeholder="username@myemail.com"
                           autocomplete="username webauthn">
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" class="form-control" id="password" name="_password"
                           autocomplete="password webauthn">
                </div>

                <button type="submit" class="btn btn-primary">Log in</button>
                <button type="button" class="btn btn-primary" id="btnLoginWithPasskey">Log in with Passkey</button>
            </form>

            <p><a href="{{ path('forgot_password') }}">Forgot password?</a></p>

        </div>
    </div>

{% endblock %}
{% block page_javascripts %}
    <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.es5.umd.min.js"></script>

    <script>
        const { startAuthentication, browserSupportsWebAuthn, startRegistration } = SimpleWebAuthnBrowser;

        // conditional login
        fetch('{{ path('passkeys_authentication_options') }}')
            .then(resp => resp.json())
            .then(opts => {
                startAuthentication(opts, true)
                    .then(async asseResp => {
                        const verificationResp = await fetch('{{ path('passkeys_authentication_verify') }}', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(asseResp),
                        });

                        const verificationJSON = await verificationResp.json();

                        if (verificationJSON && verificationJSON.verified) {
                            window.location.href = verificationJSON.redirect;
                        } else {
                            // show error message in UI
                            // user likely doesn't have a passkey registered with the app
                            console.log(verificationJSON.error);
                            $('#loginForm').prepend('<div class="alert alert-danger">You do not have a passkey registered with the app. Please log in with your username and password.</div>');
                        }
                    })
                    .catch(err => {
                        console.error('(Autofill)', err);
                    });
            });
        // end conditional login


        // Hide the Begin button if the browser is incapable of using WebAuthn
        if (!browserSupportsWebAuthn()) {
            document.querySelector('#btnLoginWithPasskey').style.display = 'none';
        } else {
            /**
             * Authentication
             */
            document.querySelector('#btnLoginWithPasskey').addEventListener('click', async () => {
                const resp = await fetch('{{ path('passkeys_authentication_options') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        username: document.querySelector('input#username').value
                    })
                })

                let asseResp;
                try {
                    const opts = await resp.json();
                    asseResp = await startAuthentication(opts);
                } catch (error) {
                    throw new Error(error);
                }

                const verificationResp = await fetch('{{ path('passkeys_authentication_verify') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(asseResp),
                });

                const verificationJSON = await verificationResp.json();

                if (verificationJSON && verificationJSON.verified) {
                    window.location.href = verificationJSON.redirect;
                } else {
                    // show error message in UI
                    console.log(verificationJSON.error);
                    $('#loginForm').prepend('<div class="alert alert-danger">You do not have a passkey registered with the app. Please log in with your username and password.</div>');
                }
            });
        }
    </script>
{% endblock %}
